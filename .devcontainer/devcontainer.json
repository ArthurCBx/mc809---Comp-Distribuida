{
  "name": "MC809 - Computacao Distribuida",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/mc809 - Comp Distribuida",
  "forwardPorts": [50051],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "zxh404.vscode-proto3"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/venv/bin/python",
        "python.terminal.activateEnvironment": false
      }
    }
  },
  "postCreateCommand": "uv sync --all-extras && find /opt/venv/lib/python*/site-packages/nvidia -name '*.so*' -printf '%h\\n' | sort -u > /etc/ld.so.conf.d/nvidia-pip.conf && ldconfig"
}
